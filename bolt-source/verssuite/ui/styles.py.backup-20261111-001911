    "red": "#f16b75",
    "purple": "#a78bfa",
    "yellow": "#e8bd65",
    "blue": "#72aaff",
    "orange": "#f2a65a",
    "text": "#e6edf3",
    "text_dim": "#84919d",
    "text_code": "#c9d6e2",
}

STATUS_COLORS = {
    "2xx": "#2dd491",
    "3xx": "#72aaff",
    "4xx": "#e8bd65",
    "5xx": "#f16b75",
}

def status_color(code):
    try:
        code = int(code)
    except (TypeError, ValueError):
        return COLORS["text_dim"]
    if 200 <= code < 300:
        return STATUS_COLORS["2xx"]
    if 300 <= code < 400:
        return STATUS_COLORS["3xx"]
    if 400 <= code < 500:
        return STATUS_COLORS["4xx"]
    if 500 <= code < 600:
        return STATUS_COLORS["5xx"]
    return COLORS["text_dim"]

